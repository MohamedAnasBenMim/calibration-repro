{
  "num_threads": 2,
  "data": {"n_val": 5000, "split_seed": 0},
  "base": {
    "model": "resnet",
    "model_kwargs": {"depth": 8, "width": 8, "bn": true},
    "epochs": 12,
    "batch_size": 128,
    "lr": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0,
    "seed": 0,
    "train_subset": 10000,
    "eval_test_every_epoch": false
  },
  "groups": [
    {"factor": "depth", "key": "depth", "values": [8, 14, 20]},
    {"factor": "width", "key": "width", "values": [4, 8, 16]},
    {"factor": "batch norm", "key": "bn", "values": [false, true],
     "base_overrides": {"model": "convnet", "model_kwargs": {"width": 16}, "lr": 0.05}},
    {"factor": "weight decay", "key": "weight_decay", "values": [0.0, 0.0001, 0.001, 0.01]}
  ]
}
